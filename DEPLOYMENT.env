# ==========================================
# 🚀 NEXT.JS FRONTEND (Vercel)
# ==========================================
# Point this to your Railway Backend URL
NEXT_PUBLIC_API_URL=https://your-api-name.up.railway.app/api/v1
# Point this to your Vercel Frontend URL
NEXT_PUBLIC_SITE_URL=https://your-hotel-website.vercel.app

# ==========================================
# 🐍 FASTAPI BACKEND (Railway)
# ==========================================
# Security
JWT_SECRET_KEY=your_random_jwt_secret_here
FRONTEND_URL=https://your-hotel-website.vercel.app
BACKEND_URL=https://your-api-name.up.railway.app

# Payments (Optional - Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Notifications (Optional - Meta WhatsApp Cloud API)
WHATSAPP_ACCESS_TOKEN=your_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_id_here
